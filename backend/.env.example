PORT=8002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_EXPIRY=10d
CORS_ORIGIN=http://127.0.0.1:5000

# FastAPI Adaptive Learning Engine. Start it on port 8001 before generating a plan.
AI_SERVICES_URL=http://127.0.0.1:8001
AI_SERVICES_ENABLED=true

# Optional: uploaded originals are retained remotely only when these are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
