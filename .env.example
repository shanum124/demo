ALE_OLLAMA_MODEL=gemma4:31b-cloud
ALE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ALE_EMBEDDING_DIMENSION=384
# true keeps requests deterministic and requires a pre-cached embedding model.
ALE_EMBEDDING_LOCAL_FILES_ONLY=true
ALE_REDIS_URL=redis://localhost:6379/0
ALE_CELERY_BROKER_URL=redis://localhost:6379/1
ALE_DATA_DIR=./data
ALE_QDRANT_DIR=./data/qdrant
ALE_QDRANT_URL=
ALE_QDRANT_API_KEY=
ALE_QDRANT_COLLECTION=notes_chunks
ALE_SQLITE_PATH=./data/engine.sqlite3
